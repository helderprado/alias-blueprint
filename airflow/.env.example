# Standalone Airflow. Copy to airflow/.env and select with ALIAS_ENV_FILE.
# Its own external metadata database must already exist.
AIRFLOW_CHART_VERSION=1.16.0
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_DATABASE_URL=
# Optional DAG source: exact commit required if Git is enabled.
AIRFLOW_DAGS_GIT_REPO=
AIRFLOW_DAGS_GIT_REF=
AIRFLOW_DAGS_SUBPATH=
AIRFLOW_GIT_CREDENTIALS_SECRET=
# Optional existing DAG PVC. No PVC is assumed by default.
AIRFLOW_DAGS_PVC=
