# Copy to glusterfs/.env; select it with ALIAS_ENV_FILE="$PWD/glusterfs/.env".
# These are example names. Supply hosts that resolve on every storage/K3s node.
GLUSTERFS_NODES='storage-1 storage-2 storage-3'
GLUSTERFS_VOLUME=alias-data
# 3 = replicated storage; 1 is allowed only for a single-node development setup.
GLUSTERFS_REPLICA_COUNT=3
# A separate filesystem must already be mounted here on EACH storage server.
# Scripts do not format devices, modify fstab or create virtual machines.
GLUSTERFS_BRICK_MOUNT=/srv/glusterfs
# Stable IP/DNS of the NFS-Ganesha gateway, reachable from every K3s node.
GLUSTERFS_NFS_SERVER=
# Comma-separated trusted K3s NODE networks/IPs; no wildcard or default route.
# Include the gateway when it is also used as an NFS client.
GLUSTERFS_CLIENT_CIDRS=
# Registry is optional: append ,registry if it should use this storage.
GLUSTERFS_PROFILES=jupyterhub,airflow,spark-operator
# Initial directory owners must match the consumer images (numeric UID/GID).
GLUSTERFS_NOTEBOOK_UID=1000
GLUSTERFS_NOTEBOOK_GID=100
GLUSTERFS_DAGS_UID=50000
GLUSTERFS_DAGS_GID=0
GLUSTERFS_REGISTRY_UID=1000
GLUSTERFS_REGISTRY_GID=1000
