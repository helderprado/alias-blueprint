# Independent configuration: export ALIAS_ENV_FILE="$PWD/minio/.env"
# Build minio/Dockerfile, publish to your registry and pin the resulting digest.
MINIO_IMAGE=
MINIO_IMAGE_PULL_SECRET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Exactly one: reuse the cluster's StorageClass, or a dedicated Bound claim in minio.
MINIO_STORAGE_CLASS=local-path
MINIO_EXISTING_CLAIM=
MINIO_STORAGE_SIZE=50Gi
MINIO_CPU_REQUEST=250m
MINIO_CPU_LIMIT=1
MINIO_MEMORY_REQUEST=512Mi
MINIO_MEMORY_LIMIT=1Gi
# Optional existing Kubernetes TLS Secret (tls.crt/tls.key; service DNS in SAN).
MINIO_TLS_SECRET=
MINIO_ALLOWED_NAMESPACES=mlflow
MINIO_CLIENTS=mlflow
MINIO_MLFLOW_BUCKETS=mlflow
MINIO_MLFLOW_ACCESS_KEY=
MINIO_MLFLOW_SECRET_KEY=
# To add independent consumers, append e.g. spark to MINIO_CLIENTS, add spark's
# namespace above, and fill MINIO_SPARK_BUCKETS, MINIO_SPARK_ACCESS_KEY and
# MINIO_SPARK_SECRET_KEY. Clients can share buckets explicitly.
