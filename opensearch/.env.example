# Standalone OpenSearch. Copy to opensearch/.env and select with ALIAS_ENV_FILE.
# Passwords: 16..72 UTF-8 bytes. Quote shell metacharacters.
OPENSEARCH_ADMIN_USER=search-admin
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_TRUSTSTORE_PASSWORD=
# Optional service account for any application, independent of the catalog.
OPENSEARCH_APP_USER=
OPENSEARCH_APP_PASSWORD=
OPENSEARCH_APP_INDEX_PATTERNS=app-*
