# Configuration template for adopters; contains no credential values.
# Current scripts do not load this file automatically. See VERSIONS.md.
# Export these variables before running install-k3s.sh.
# If K3S_CONFIG is unset, the script uses k3s-config.yaml next to itself.
K3S_VERSION=v1.34.13+k3s1
K3S_CONFIG=./k3s-config.yaml
# Fill these values locally; do not commit .env.
REGISTRY_HOST=
REGISTRY_USER=
REGISTRY_PASSWORD=
# Other component variables require author confirmation.
