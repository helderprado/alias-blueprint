# Copy to .env at the repository root; chmod 600 .env; fill the section you use.
# Entry scripts load this trusted Bash file automatically. Quote values containing
# spaces or shell metacharacters with single quotes. Never commit .env.
# ALIAS_ENV_FILE may select another trusted file. File assignments override exports.
# Empty credential fields below are deliberately unusable.

# K3s: defaults are fixed in install-k3s.sh; leave K3S_CONFIG unset to use repo YAML.
K3S_VERSION=v1.34.13+k3s1
# K3S_CONFIG=/path/to/k3s-config.yaml

# Registry generator, deploy and pull-secret wrappers (required for these scripts).
# Use a dedicated non-administrative account; enforce pull-only scope at registry.
REGISTRY_HOST=
REGISTRY_USER=
REGISTRY_PASSWORD=
REGISTRY_SERVICE_ACCOUNT=registry-puller

# JupyterHub: both required by jupyterhub/deploy.sh.
# Generate the crypt key with: openssl rand -hex 32
JUPYTERHUB_CRYPT_KEY=
JUPYTERHUB_AUTH_PASSWORD=

# MLflow: all required by mlflow/deploy.sh except DB_PORT, which defaults to 3306.
# Database and S3 bucket must already exist and permit this account to connect.
# Optional MinIO S3: see minio/README.md; configure it independently with
# python3 minio/configure.py and import the selected client connection explicitly.
MLFLOW_DB_HOST=
MLFLOW_DB_PORT=3306
MLFLOW_DB_NAME=
MLFLOW_DB_USER=
MLFLOW_DB_PASSWORD=
MLFLOW_S3_BUCKET=
MLFLOW_S3_ENDPOINT_URL=
MLFLOW_S3_ACCESS_KEY_ID=
MLFLOW_S3_SECRET_ACCESS_KEY=

# Superset: all required by superset/deploy.sh. External PostgreSQL on port 5432.
# The chart-managed Redis receives the same password via an existing Secret.
# Generate SUPERSET_SECRET_KEY with: openssl rand -hex 32
SUPERSET_SECRET_KEY=
SUPERSET_DB_HOST=
SUPERSET_DB_NAME=
SUPERSET_DB_USER=
SUPERSET_DB_PASSWORD=
SUPERSET_REDIS_PASSWORD=

# Airflow: all keys required by airflow/deploy.sh; database must already exist.
# DATABASE_URL is a complete SQLAlchemy URL; URL-encode user/password characters.
# Generate Fernet with Python cryptography.fernet.Fernet.generate_key().decode().
AIRFLOW_CHART_VERSION=1.16.0
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_DATABASE_URL=
# AIRFLOW_VALUES=/path/to/values.yaml
# Optional DAG delivery. No private Git repository or existing PVC is assumed.
AIRFLOW_DAGS_GIT_REPO=
AIRFLOW_DAGS_GIT_REF=
AIRFLOW_DAGS_SUBPATH=
AIRFLOW_GIT_CREDENTIALS_SECRET=
AIRFLOW_DAGS_PVC=

# OpenSearch: independent search service; no OPENMETADATA_* setting is required.
# Run gen-security.sh, then deploy.sh. Passwords require 16..72 UTF-8 bytes.
OPENSEARCH_ADMIN_USER=search-admin
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_TRUSTSTORE_PASSWORD=
# Optional generic application account: set both fields or leave both empty.
OPENSEARCH_APP_USER=
OPENSEARCH_APP_PASSWORD=
# Comma-separated allowed index patterns for this optional account.
OPENSEARCH_APP_INDEX_PATTERNS=app-*

# OpenMetadata: optional consumer; requires PostgreSQL, OIDC and a search endpoint.
# Run bash openmetadata/gen-keys.sh once; existing JWT keys are preserved.
# These file paths are relative to the repo root, even when run from elsewhere.
OPENMETADATA_JWT_PRIVATE_KEY_FILE=openmetadata/runtime-creds/private_key.der
OPENMETADATA_JWT_PUBLIC_KEY_FILE=openmetadata/runtime-creds/public_key.der
# Generate a separate Fernet key, using the same method documented for Airflow.
OPENMETADATA_FERNET_KEY=
OPENMETADATA_PUBLIC_URL=
# Initial administrator is an identity from your IdP, not a default password.
OPENMETADATA_ADMIN_PRINCIPAL=
OPENMETADATA_PRINCIPAL_DOMAIN=
OPENMETADATA_OIDC_AUTHORITY=
OPENMETADATA_OIDC_DISCOVERY_URL=
OPENMETADATA_OIDC_JWKS_URL=
OPENMETADATA_OIDC_CLIENT_ID=
OPENMETADATA_OIDC_CLIENT_SECRET=
OPENMETADATA_DB_HOST=
OPENMETADATA_DB_PORT=5432
OPENMETADATA_DB_NAME=
OPENMETADATA_DB_USER=
OPENMETADATA_DB_PASSWORD=
OPENMETADATA_DB_PARAMS='sslmode=require'
OPENMETADATA_SEARCH_HOST=
OPENMETADATA_SEARCH_PORT=9200
OPENMETADATA_SEARCH_SCHEME=https
OPENMETADATA_SEARCH_USER=
OPENMETADATA_SEARCH_PASSWORD=
# Optional private CA truststore; leave empty for a publicly trusted search CA.
OPENMETADATA_SEARCH_TRUSTSTORE_FILE=
OPENMETADATA_SEARCH_TRUSTSTORE_PASSWORD=

# Standalone Trino. Copy to trino/.env and select with ALIAS_ENV_FILE.
TRINO_USER=
TRINO_PASSWORD=
# Generate a stable shared secret with: openssl rand -hex 32
TRINO_SHARED_SECRET=
TRINO_WORKERS=1
# Optional comma-separated client namespaces permitted to reach HTTPS port 8443.
TRINO_ALLOWED_NAMESPACES=
# Optional JSON map of catalog-name -> properties text; stored in a runtime Secret.
# Copy catalogs.example.json under ignored runtime-creds/ before adding credentials.
TRINO_CATALOGS_FILE=

# Independent Pinot service. No Trino/OpenMetadata credentials are required.
PINOT_CLUSTER_NAME=pinot
# Empty = use the chart's persistent ZooKeeper. Otherwise provide host:port/chroot.
PINOT_ZOOKEEPER_URL=
# Empty = default Kubernetes StorageClass.
PINOT_STORAGE_CLASS=
# Trusted namespaces allowed to access controller 9000 and broker 8099.
# This profile is private HTTP, without Pinot API authentication.
PINOT_ALLOWED_NAMESPACES=

# Optional GlusterFS shared filesystem; glusterfs/.env.example has the full profile.
# Hosts/disks must exist first. This is independent of MLflow's S3 storage.
GLUSTERFS_NODES=
GLUSTERFS_VOLUME=alias-data
GLUSTERFS_REPLICA_COUNT=3
GLUSTERFS_BRICK_MOUNT=/srv/glusterfs
GLUSTERFS_NFS_SERVER=
GLUSTERFS_CLIENT_CIDRS=
GLUSTERFS_PROFILES=jupyterhub,airflow,spark-operator

# Spark: independent compute profile; see spark/README.md.
# Baseline compute-only smoke check uses the committed Apache Spark 3.5.0 image.
# S3/JDBC integrations require a built pyspark-aws-psql image, pinned by digest.
SPARK_IMAGE=
SPARK_IMAGE_PULL_SECRET=
SPARK_APPLICATION_NAME=alias-spark-smoke
SPARK_DRIVER_CORES=1
SPARK_DRIVER_CPU_REQUEST=500m
SPARK_DRIVER_CPU_LIMIT=1
SPARK_DRIVER_MEMORY=512m
SPARK_DRIVER_MEMORY_OVERHEAD=384m
SPARK_EXECUTORS=1
SPARK_EXECUTOR_CORES=1
SPARK_EXECUTOR_CPU_REQUEST=500m
SPARK_EXECUTOR_CPU_LIMIT=1
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_MEMORY_OVERHEAD=384m
# Aggregate budget for ALL jobs in namespace spark; operator is in spark-operator.
SPARK_QUOTA_CPU=4
SPARK_QUOTA_MEMORY=8Gi
SPARK_QUOTA_PODS=12
# Optional existing Bound PVC in spark, mounted read-only at /opt/spark/shared.
SPARK_DAGS_PVC=
SPARK_S3_ENABLED=false
SPARK_S3_ENDPOINT_URL=
SPARK_S3_BUCKET=
SPARK_S3_ACCESS_KEY_ID=
SPARK_S3_SECRET_ACCESS_KEY=
# Generic S3_* and AWS_* exports from minio/connection.sh are also supported.
SPARK_DB_ENABLED=false
SPARK_DB_URL=
SPARK_DB_USER=
SPARK_DB_PASSWORD=
